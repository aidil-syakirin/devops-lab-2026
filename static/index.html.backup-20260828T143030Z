    <style>
        :root {
            --accent: #2563eb;
            --heading: #1f2937;
            --text: #374151;
            --muted: #6b7280;
            --border: #d1d5db;
        }

        * { box-sizing: border-box; }

        body {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 28px;
            color: var(--text);
            background: #fff;
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            font-size: 15px;
            line-height: 1.6;
        }

        header { margin-bottom: 30px; }

        h1 {
            margin: 0;
            color: var(--heading);
            font-size: clamp(1.65rem, 5vw, 2.25rem);
            line-height: 1.2;
            letter-spacing: -0.025em;
        }

        .headline {
            margin: 7px 0 12px;
            color: var(--accent);
            font-size: 1.05rem;
            font-weight: 600;
        }

        .contact {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 14px;
            color: var(--muted);
            font-size: 0.92rem;
        }

        a { color: var(--accent); text-decoration: none; }
        a:hover, a:focus { text-decoration: underline; }

        section { margin-top: 27px; }

        h2 {
            margin: 0 0 13px;
            padding-bottom: 6px;
            border-bottom: 1px solid var(--border);
            color: var(--heading);
            font-size: 1.15rem;
            letter-spacing: 0.01em;
        }

        p { margin: 0; }
        ul { margin: 8px 0 0; padding-left: 21px; }
        li { margin-bottom: 6px; }

        .skills { list-style: none; padding: 0; }
        .skills li { margin-bottom: 7px; }

        .role, .project-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 18px;
        }

        .role + .role { margin-top: 22px; }
        .role-title, .project-title { color: var(--heading); font-weight: 700; }
        .company { color: var(--muted); }
        .date { flex: 0 0 auto; color: var(--muted); font-size: 0.9rem; }
        .role-details { width: 100%; }

        footer {
            margin-top: 30px;
            padding-top: 10px;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.8rem;
        }

        @media (max-width: 640px) {
            body { padding: 25px 18px; }
            .role, .project-heading { display: block; }
            .date { display: block; margin-top: 2px; }
        }

        @media print {
            :root { --accent: #1f2937; }
            @page { size: A4; margin: 13mm; }
            body { max-width: none; padding: 0; font-size: 10.5pt; line-height: 1.42; }
            header { margin-bottom: 18px; }
            section { margin-top: 17px; break-inside: avoid; }
            h2 { margin-bottom: 8px; }
            li { margin-bottom: 3px; }
            a { color: inherit; }
            footer { display: none; }
        }
    </style>
